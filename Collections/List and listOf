package com.shashank.collections;

import java.util.*;

/**
 *
 */
public class CollectionsEx4 {
    public static void main(String[] args) {
        List a=List.of(10,20,12,5.3,3,"Ram");//Immutable Collection
        //ArrayList a=List.of(10,20,12,5.3,3);//error
        
        //a.add(90);//java.lang.UnsupportedOperationException
        //a.remove(2);//java.lang.UnsupportedOperationException
        //a.set(2, 90);//java.lang.UnsupportedOperationException
        
        System.out.println(a);
        
        List b=Arrays.asList(10,20,12,5.3,3,"Ram");//Fixed size collection
        //b.add(90);//java.lang.UnsupportedOperationException
        //b.remove(2);//java.lang.UnsupportedOperationException
        b.set(2, 90);//Can modify values
        System.out.println(b);
    }
}
